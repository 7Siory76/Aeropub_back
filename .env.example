# Configuration du serveur
PORT=5000
NODE_ENV=development

# Base de données PostgreSQL (Local, Supabase ou Neon.tech)
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/aeropub

# Configuration de la messagerie SMTP (Envoi d'e-mails de relance et préavis)
# Exemple pour Gmail : utiliser un mot de passe d'application généré depuis le compte Google
EMAIL_PASS=votre_mot_de_passe_application_ici
SMTP_PASS=votre_mot_de_passe_application_ici
