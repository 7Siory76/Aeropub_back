# Configuration du serveur
PORT=5000
NODE_ENV=development

# Base de données PostgreSQL (Neon.tech / Supabase)
# Exemple: postgresql://aeropub_user:aeropub@localhost:5432/aeropub
DATABASE_URL=postgresql://aeropub_user:aeropub@localhost:5432/aeropub

# Configuration Firebase Admin SDK (Notifications Push FCM)
FIREBASE_PROJECT_ID=votre-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@votre-projet.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMODELE_DE_CLE_PRIVEE_FIREBASE\n-----END PRIVATE KEY-----\n"
